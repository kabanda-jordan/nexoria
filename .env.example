# Environment Variables
# Copy this file to .env and fill in your values — NEVER commit .env to git

# Resend API Key (get yours at https://resend.com)
VITE_RESEND_API_KEY=your_resend_api_key_here

# Cloudinary image uploads (unsigned upload preset — no secret needed)
# Find both in your Cloudinary dashboard: Settings → Upload → "Upload presets"
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here

# Database (PostgreSQL)
DATABASE_URL=postgresql://nexora:nexora_password@localhost:5432/nexora_db

# JWT Secrets (generate strong random strings in production)
JWT_SECRET=change_me_to_a_long_random_string_in_production
REFRESH_SECRET=change_me_to_another_long_random_string_in_production

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=nexora_meilisearch_master_key
